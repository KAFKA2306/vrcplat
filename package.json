{
  "name": "vrcplat",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "check": "pnpm lint && pnpm --filter @vrcplat/contracts test && pnpm --filter @vrcplat/service-identity test && pnpm build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r run build"
  },
  "workspaces": ["services/*", "apps/*", "packages/*", "packages/*/*"]
}
